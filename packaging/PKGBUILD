# Maintainer: Shea Duncan
pkgname=omacell
pkgver=0.0.0
pkgrel=1
pkgdesc='Keyboard-first spreadsheet for Omarchy Linux'
arch=('x86_64' 'aarch64')
url='https://github.com/sheaduncan/omacell'
license=('MIT')
# makepkg's GCC `-flto=auto` turns ring's bundled C/assembly objects into
# plugin LTO objects that rust-lld cannot recover from the Rust archive. Cargo
# still applies the workspace's Rust thin-LTO release profile.
options=('!lto' 'docs')
depends=(
  'fontconfig'
  'gcc-libs'
  'glibc'
  'libxkbcommon'
  'mesa'
  'shared-mime-info'
  'ttf-carlito'
  'ttf-liberation'
  'wayland'
  'gtk-update-icon-cache'
)
makedepends=('cargo' 'mdbook' 'python' 'rust')
checkdepends=('desktop-file-utils' 'libxml2')
optdepends=(
  'cups: print through a system printer'
  'omarchy: desktop theme, menu, and agent integration'
)
install=omacell.install
_source_url="${PKGBUILD_SOURCE_URL:-${url}/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz}"
_source_sha256="${PKGBUILD_SOURCE_SHA256:-REPLACE_WITH_RELEASE_SHA256}"
source=(
  "${pkgname}-${pkgver}.tar.gz::${_source_url}"
  'omacell.install'
)
sha256sums=("${_source_sha256}" 'edfb1241b942e8dc5d3080b6d6e567d45448976f6b910a48e51473503c55bdd7')

prepare() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  cargo fetch --locked --target "${CARCH}-unknown-linux-gnu"
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  export CARGO_TARGET_DIR="${srcdir}/${pkgname}-${pkgver}/target"
  cargo build --frozen --release -p omacell-cli -p omacell-xls-worker
  cargo test --frozen -p omacell-cli --test dist generate_completions_and_man
  cargo run --frozen -p omacell-cli --example generate-docs -- docs/book/cli-reference.md
  python scripts/generate-docs.py --write
  mdbook build
}

check() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  export CARGO_TARGET_DIR="${srcdir}/${pkgname}-${pkgver}/target"
  cargo test --frozen --workspace
  cargo run --frozen -p omacell-cli --example generate-docs -- --check docs/book/cli-reference.md
  python scripts/generate-docs.py --check
  desktop-file-validate packaging/omacell.desktop
  xmllint --noout packaging/omacell.xml
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  install -Dm755 target/release/omacell "${pkgdir}/usr/bin/omacell"
  install -Dm755 target/release/omacell-xls-worker \
    "${pkgdir}/usr/lib/omacell/omacell-xls-worker"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 packaging/omacell.desktop \
    "${pkgdir}/usr/share/applications/omacell.desktop"
  install -Dm644 packaging/omacell.xml \
    "${pkgdir}/usr/share/mime/packages/omacell.xml"
  install -d "${pkgdir}/usr/share/omacell" \
    "${pkgdir}/usr/share/icons" \
    "${pkgdir}/usr/share/doc/${pkgname}/manual"
  cp -a default "${pkgdir}/usr/share/omacell/default"
  cp -a i18n "${pkgdir}/usr/share/omacell/i18n"
  cp -a packaging/icons/hicolor "${pkgdir}/usr/share/icons/"
  install -Dm644 target/dist/omacell.1 \
    "${pkgdir}/usr/share/man/man1/omacell.1"
  install -Dm644 target/dist/omacell.bash \
    "${pkgdir}/usr/share/bash-completion/completions/omacell"
  install -Dm644 target/dist/omacell.fish \
    "${pkgdir}/usr/share/fish/vendor_completions.d/omacell.fish"
  install -Dm644 target/dist/_omacell \
    "${pkgdir}/usr/share/zsh/site-functions/_omacell"
  cp -a book/. "${pkgdir}/usr/share/doc/${pkgname}/manual/"
  test -f "${pkgdir}/usr/share/doc/${pkgname}/manual/index.html"
}
