{
  "protocol": "openai_compatible",
  "request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "body": {
      "model": "qwen",
      "messages": [
        { "role": "user", "content": "continue tool" },
        {
          "role": "assistant",
          "content": "",
          "tool_calls": [
            {
              "id": "call_1",
              "type": "function",
              "function": { "name": "sum", "arguments": "{\"a\":1}" }
            }
          ]
        },
        { "role": "tool", "content": "1", "tool_call_id": "call_1" }
      ],
      "stream": false,
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "sum",
            "description": "add",
            "parameters": { "type": "object" }
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "body": {
      "choices": [ { "message": { "content": "done" } } ],
      "usage": { "prompt_tokens": 8, "completion_tokens": 1 }
    }
  }
}
