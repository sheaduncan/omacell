{
  "protocol": "openai_compatible",
  "request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "body": {
      "model": "qwen",
      "messages": [
        { "role": "user", "content": "call tool" }
      ],
      "stream": false,
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "sum",
            "description": "add",
            "parameters": { "type": "object" }
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "body": {
      "choices": [
        {
          "message": {
            "role": "assistant",
            "content": "",
            "tool_calls": [
              {
                "id": "call_1",
                "function": { "name": "sum", "arguments": "{\"a\":1}" }
              }
            ]
          }
        }
      ],
      "usage": { "prompt_tokens": 2, "completion_tokens": 1 }
    }
  }
}
