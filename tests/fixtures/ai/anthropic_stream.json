      { "type": "content_block_start", "index": 1, "content_block": {
        "type": "tool_use", "id": "tool_1", "name": "sum", "input": {}
      } },
      { "type": "content_block_delta", "index": 1, "delta": {
        "type": "input_json_delta", "partial_json": "{\"a\":"
