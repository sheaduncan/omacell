{
  "protocol": "anthropic",
  "request": {
    "method": "POST",
    "path": "/v1/messages",
    "body": {
      "model": "claude",
      "max_tokens": 1024,
      "messages": [
        { "role": "user", "content": "continue tool" },
        {
          "role": "assistant",
          "content": [
            { "type": "tool_use", "id": "call_1", "name": "sum", "input": { "a": 1 } }
          ]
        },
        {
          "role": "user",
          "content": [
            { "type": "tool_result", "tool_use_id": "call_1", "content": "1" }
          ]
        }
      ],
      "stream": false,
      "tools": [
        { "name": "sum", "description": "add", "input_schema": { "type": "object" } }
      ]
    }
  },
  "response": {
    "status": 200,
    "body": {
      "content": [ { "type": "text", "text": "done" } ],
      "usage": { "input_tokens": 8, "output_tokens": 1 }
    }
  }
}
