{
  "protocol": "openai_compatible",
  "request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "body": {
      "model": "qwen",
      "messages": [
        { "role": "user", "content": "slow" }
      ],
      "stream": false
    }
  },
  "response": {
    "status": 200,
    "delay_ms": 200,
    "body": {
      "choices": [ { "message": { "content": "late" } } ]
    }
  }
}
